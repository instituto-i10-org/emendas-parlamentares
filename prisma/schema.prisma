// Emendas360 — modelo de domínio (v2).
//
// Emendas parlamentares impositivas sobre o orçamento municipal (PPA/LDO/LOA),
// com o fluxo de três etapas desenhado no protótipo RIEP: descrever a emenda,
// montar o plano de trabalho e validar antes de submeter.
//
// Princípios:
//  - Nada do município no código. Cota, percentuais, códigos AUDESP, áreas de
//    aplicação e a biblioteca de objetos vivem no banco e são carregados por
//    seed ou pela tela de configuração. Um deploy atende um município.
//  - Classificação orçamentária por FK. A dotação guarda também o código de
//    exibição e a ficha, que é como as pessoas a citam.
//  - Valores monetários em Decimal(18,2); quantidades em Decimal(18,4).
//  - Auth.js (User/Account/Session/VerificationToken) em inglês por exigência
//    do adapter; o restante do domínio em português.
//
// Prisma 7 usa driver adapters: a URL vem do prisma.config.ts (CLI) e de
// src/lib/prisma.ts (runtime).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// ENUMS
// ============================================================================

enum Poder {
  LEGISLATIVO
  EXECUTIVO
}

enum StatusExercicio {
  ABERTO
  ENCERRADO
}

enum TipoInstrumento {
  PPA
  LDO
  LOA
}

enum EspecieInstrumento {
  PROJETO_LEI
  LEI_APROVADA
}

enum StatusInstrumento {
  EM_ELABORACAO
  ENVIADO
  EM_TRAMITACAO
  APROVADO
  SANCIONADO
  VIGENTE
  ENCERRADO
}

enum TipoAcao {
  PROJETO
  ATIVIDADE
  OPERACAO_ESPECIAL
}

enum TipoNorma {
  LOM
  REGIMENTO_INTERNO
  LEI
  RESOLUCAO
  ATO_DA_MESA
  DECRETO
  PORTARIA
  COMUNICADO
  OUTRO
}

// Como a reserva mínima da saúde é conferida (definido na LDO): no conjunto das
// emendas do autor (GLOBAL) ou em cada emenda (INDIVIDUAL).
enum AfericaoSaude {
  GLOBAL
  INDIVIDUAL
}

// Quem executa a despesa. Define a modalidade de aplicação: 90 na direta, 50
// na indireta (transferência a instituição privada sem fins lucrativos).
enum FormaExecucao {
  DIRETA
  INDIRETA
}

enum NaturezaObjeto {
  CUSTEIO
  CAPITAL
}

// Divisível: a quantidade é proporcional ao valor. Indivisível: quem recebe o
// bem é a unidade inteira, e o alcance vem da população de referência.
enum Divisibilidade {
  DIVISIVEL
  INDIVISIVEL
}

// Parcela da cota que a emenda consome. Decidida pelo IC-CO da dotação
// (1002 = ações e serviços públicos de saúde), nunca por escolha do autor.
enum ParcelaCota {
  SAUDE
  DEMAIS
}

// Origem do cadastro de um destino.
enum OrigemDestino {
  BASE_OFICIAL // CNES, Censo Escolar, SUAS, Receita Federal
  CADASTRO // incluído por um usuário do sistema
}

// Resultado da classificação da etapa 1.
enum SituacaoClassificacao {
  OK // dotação encontrada ou escolhida
  VALIDAR // mais de uma candidata, objeto não reconhecido ou sem aderência
  OBICE // nenhuma dotação comporta o objeto
  CONFLITO // objeto de área estrita num destino de outra área
  INDETERMINADO // não foi possível reconhecer o que a emenda entrega
}

// Quem definiu a dotação.
enum EscolhaDotacao {
  SISTEMA
  PROPONENTE
  ANALISE_TECNICA
}

// Os quatro formulários oficiais de plano de trabalho. Não é escolha do autor:
// sai da dotação (modalidade, grupo e elemento).
enum ModeloPlanoTrabalho {
  CUSTEIO // Modelo I
  OBRAS // Modelo II
  TERCEIRO_SETOR // Modelo III
  EQUIPAMENTOS // Modelo IV
}

// Instrumento pretendido no terceiro setor. É ele que define o elemento de
// despesa (41, 42 ou 43), e por isso não é deduzido pelo motor.
enum InstrumentoParceria {
  PARCERIA_MROSC // Lei 13.019/2014 — fomento ou colaboração
  CONTRIBUICAO_LEI // contribuição instituída por lei
  OUTRO
}

// O ato do Executivo que encerra a meta, na execução.
enum EventoComprovacao {
  PATRIMONIO
  ALMOXARIFADO
  LIQUIDACAO
  RECEBIMENTO_DEFINITIVO
  RECEBIMENTO_ETAPA
  PRESTACAO_CONTAS
  PRESTACAO_CONTAS_DOACAO
}

enum TipoReferenciaPreco {
  ATA
  CONTRATACAO_MUNICIPIO
  CONTRATACAO_OUTRO_ORGAO
  PAINEL
  BANCO_PRECOS_SAUDE
  TABELA_OFICIAL
  COTACAO
  NOTA_FISCAL
  TERMO_PARCERIA
  ESTIMATIVA
}

// Informada: registrada pelo proponente. Conferida: resultado de pesquisa de
// preço aprovado por alguém que declarou ter conferido a fonte.
enum ProcedenciaReferencia {
  INFORMADA
  CONFERIDA
}

enum StatusEmenda {
  RASCUNHO
  // Validação em andamento no servidor (transitória).
  EM_VALIDACAO
  // Validada sem falha: pode ser remetida.
  VALIDA
  // Recusada pelo servidor na remessa (ao menos uma falha): volta ao autor.
  INVALIDA
  SUBMETIDA
  // Recebida pela Comissão para análise.
  EM_TRAMITACAO
  // Devolvida pela Comissão para o autor sanear (Regimento Interno, art.
  // 210-C, § 2º); volta à fila com o mesmo número ao ser reenviada.
  EM_DILIGENCIA
  APROVADA
  REJEITADA
}

// Como uma verificação se aplica: impede a remessa ou só avisa.
enum ModoValidacao {
  BLOQUEANTE
  ALERTA
}

// Momento em que a validação foi executada.
enum MomentoValidacao {
  VALIDACAO
  REMESSA
  REENVIO
}

enum ResultadoViabilidade {
  VIAVEL
  VIAVEL_COM_RESSALVA
  INVIAVEL
}

enum TipoCarga {
  DOTACOES // LOA: dotações
  PRIORIDADES_LDO // LDO: prioridades e metas
  PROGRAMAS_PPA // PPA: programas e metas
}

enum FormatoImportacao {
  PLANILHA
  PDF_TEXTO
  PDF_IMAGEM
  IMAGEM
}

enum SituacaoImportacao {
  MAPEAR // planilha com coluna obrigatória não reconhecida: o usuário liga
  LENDO // leitura em andamento (PDF ou imagem, por lotes)
  LIDA // pronta para conferência
  GRAVADA
  CANCELADA
  ERRO
}

// Para que um arquivo foi enviado. Define tipo aceito, tamanho e quem lê.
enum UsoArquivo {
  PECA_ORCAMENTARIA // PPA, LDO, LOA (projeto ou lei)
  NORMA // Lei Orgânica, Regimento, demais atos
  IMPORTACAO // arquivo lido pela importação da base
}

// Etapas da despesa pública (Lei 4.320/1964, arts. 58 a 65).
enum EtapaExecucao {
  EMPENHO
  LIQUIDACAO
  PAGAMENTO
}

// ============================================================================
// MUNICÍPIO E EXERCÍCIO
// ============================================================================

// O município atendido por este deploy. Uma única linha.
model Municipio {
  id                   String    @id @default(cuid())
  nome                 String
  uf                   String
  codigoIbge           String?
  nomeCamara           String?
  nomePrefeitura       String?
  // Portal público ligado (a conformidade confere com uma consulta real).
  portalPublico        Boolean   @default(true)
  // Manual orientativo: instituído por ato cadastrado nas normas e publicado.
  manualAtoId          String?
  manualPublicadoEm    DateTime?
  manualPublicadoPorId String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  manualAto          DocumentoNormativo? @relation("AtoDoManual", fields: [manualAtoId], references: [id], onDelete: SetNull)
  manualPublicadoPor User?               @relation("ManualPublicado", fields: [manualPublicadoPorId], references: [id], onDelete: SetNull)
}

// Exercício orçamentário (ano). Contexto de dados de toda a aplicação.
model Exercicio {
  id        String          @id @default(cuid())
  ano       Int             @unique
  status    StatusExercicio @default(ABERTO)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  configuracao      ConfiguracaoExercicio?
  prazos            PrazoExercicio[]
  orgaos            Orgao[]
  unidades          UnidadeOrcamentaria[]
  funcoes           Funcao[]
  subfuncoes        Subfuncao[]
  programas         Programa[]
  acoes             Acao[]
  naturezas         NaturezaDespesa[]
  fontes            FonteRecurso[]
  instrumentos      InstrumentoPlanejamento[]
  dotacoes          Dotacao[]
  metasAcao         MetaAcao[]
  emendas           Emenda[]
  emendasImportadas EmendaImportada[]
  contador          ContadorEmenda?
  prioridades       PrioridadeLdo[]
  regras            RegraValidacao[]
}

// Parâmetros das emendas impositivas no exercício. Campo nulo significa
// "não parametrizado": o sistema mostra a pendência e não presume valor.
model ConfiguracaoExercicio {
  id          String @id @default(cuid())
  exercicioId String @unique

  // --- cota individual -------------------------------------------------------
  cotaIndividual   Decimal? @db.Decimal(18, 2)
  percentualRcl    Decimal? @db.Decimal(7, 4)
  rclBase          Decimal? @db.Decimal(18, 2)
  rclAnoBase       Int?
  rclObservacao    String?
  numeroVereadores Int?
  // A conta por extenso, para quem precisar conferir de onde veio a cota.
  memoriaCota      String?

  // --- reserva da saúde ------------------------------------------------------
  percentualSaude Decimal       @default(50) @db.Decimal(5, 2)
  afericaoSaude   AfericaoSaude @default(GLOBAL)
  observacaoSaude String?

  // --- tolerâncias do motor --------------------------------------------------
  // Diferença aceita entre a planilha e o valor da emenda: até ela, avisa;
  // acima, trava o envio.
  toleranciaValorPct      Decimal @default(10) @db.Decimal(5, 2)
  // Referência de preço mais antiga que isto acende alerta.
  validadeReferenciaMeses Int     @default(12)
  // Linha da memória de cálculo abaixo deste percentual do total é acessória.
  percentualAcessorio     Decimal @default(20) @db.Decimal(5, 2)

  // --- identificadores AUDESP (camada C) ------------------------------------
  // As tabelas do AUDESP são revistas a cada ano: nada disto é fixo no código.
  fonteAudesp        String?
  fonteAudespNome    String?
  codigoAplicacao    String?
  formatoVariacao    Int     @default(4)
  variacaoOcupaFonte Boolean @default(false)
  icEpVigente        Boolean @default(false)
  icEpCodigo         String?

  // --- alcance das emendas ---------------------------------------------------
  // Órgãos cujo orçamento não recebe emenda (ex.: a própria Câmara e os
  // encargos gerais do município). Códigos de órgão ("01", "17").
  orgaosForaDasEmendas String[] @default([])

  // --- contexto --------------------------------------------------------------
  // Como a base aparece para quem elabora ("LOA 2026 (Lei 6.246/2025)").
  rotuloBase           String?
  // Fim do protocolo de emendas; depois disso não se submete.
  prazoProtocolo       DateTime?
  // Situações do projeto de lei (LOA) em que ele recebe emendas.
  situacoesEmendamento StatusInstrumento[] @default([EM_TRAMITACAO])
  // Fundamento normativo por extenso de cada parâmetro: { cotaIndividual: { texto, normaId } }.
  fundamentos          Json                @default("{}")

  // --- obras: custo de referência do m² de construção ----------------------
  // Usado para sugerir o item único "em m²" nas emendas de obra. Vem de
  // referência oficial (ex.: custo médio do m² SINAPI/IBGE para SP).
  custoM2Referencia   Decimal? @db.Decimal(12, 2)
  custoM2Competencia  String?
  custoM2Fonte        String?
  custoM2Url          String?
  // Prazo padrão da diligência, em dias (RI, art. 210-C, § 2º: 5 dias).
  prazoDiligenciaDias Int      @default(5)

  // --- preços e plano da entidade --------------------------------------------
  // Item com preço e sem fonte informada: bloqueia a submissão (verdadeiro) ou
  // só alerta (falso).
  fontePrecoObrigatoria    Boolean @default(true)
  // Dias de validade do link que a entidade usa para preencher o plano.
  validadeLinkEntidadeDias Int     @default(10)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  exercicio Exercicio @relation(fields: [exercicioId], references: [id], onDelete: Cascade)
}

// Prazos do calendário das emendas (LOA, LDO, AUDESP). Informativos.
model PrazoExercicio {
  id          String   @id @default(cuid())
  exercicioId String
  descricao   String
  data        DateTime
  url         String?
  createdAt   DateTime @default(now())

  exercicio Exercicio @relation(fields: [exercicioId], references: [id], onDelete: Cascade)

  @@index([exercicioId, data])
}

// ============================================================================
// CLASSIFICAÇÃO ORÇAMENTÁRIA (por exercício)
// ============================================================================

model Orgao {
  id          String   @id @default(cuid())
  codigo      String
  nome        String
  exercicioId String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  exercicio Exercicio             @relation(fields: [exercicioId], references: [id], onDelete: Cascade)
  unidades  UnidadeOrcamentaria[]
  dotacoes  Dotacao[]

  @@unique([exercicioId, codigo])
}

// Unidade orçamentária. `codigo` é o código completo ("13.01").
model UnidadeOrcamentaria {
  id          String   @id @default(cuid())
  codigo      String
  nome        String
  orgaoId     String
  exercicioId String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orgao     Orgao      @relation(fields: [orgaoId], references: [id], onDelete: Cascade)
  exercicio Exercicio  @relation(fields: [exercicioId], references: [id], onDelete: Cascade)
  dotacoes  Dotacao[]
  metas     MetaAcao[]

  @@unique([exercicioId, codigo])
  @@index([orgaoId])
}

model Funcao {
  id          String   @id @default(cuid())
  codigo      String
  nome        String
  exercicioId String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  exercicio  Exercicio   @relation(fields: [exercicioId], references: [id], onDelete: Cascade)
  subfuncoes Subfuncao[]
  dotacoes   Dotacao[]

  @@unique([exercicioId, codigo])
}

model Subfuncao {
  id          String   @id @default(cuid())
  codigo      String
  nome        String
  funcaoId    String
  exercicioId String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  funcao    Funcao    @relation(fields: [funcaoId], references: [id], onDelete: Cascade)
  exercicio Exercicio @relation(fields: [exercicioId], references: [id], onDelete: Cascade)
  dotacoes  Dotacao[]

  @@unique([exercicioId, funcaoId, codigo])
  @@index([funcaoId])
}

model Programa {
  id          String   @id @default(cuid())
  codigo      String
  nome        String
  // Consta do PPA vigente? (LOM art. 140 §1º, I).
  constaNoPPA Boolean  @default(false)
  exercicioId String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  exercicio   Exercicio       @relation(fields: [exercicioId], references: [id], onDelete: Cascade)
  acoes       Acao[]
  dotacoes    Dotacao[]
  metas       MetaAcao[]
  prioridades PrioridadeLdo[]

  @@unique([exercicioId, codigo])
}

model Acao {
  id          String   @id @default(cuid())
  codigo      String
  nome        String
  tipo        TipoAcao
  programaId  String
  exercicioId String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  programa    Programa        @relation(fields: [programaId], references: [id], onDelete: Cascade)
  exercicio   Exercicio       @relation(fields: [exercicioId], references: [id], onDelete: Cascade)
  dotacoes    Dotacao[]
  metas       MetaAcao[]
  prioridades PrioridadeLdo[]

  @@unique([exercicioId, programaId, codigo])
  @@index([programaId])
}

// Natureza da despesa ("4.4.90.52"): categoria, grupo, modalidade e elemento.
model NaturezaDespesa {
  id                  String   @id @default(cuid())
  codigo              String
  categoriaEconomica  String
  grupo               String
  modalidadeAplicacao String
  elemento            String
  nome                String?
  exercicioId         String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  exercicio Exercicio @relation(fields: [exercicioId], references: [id], onDelete: Cascade)
  dotacoes  Dotacao[]

  @@unique([exercicioId, codigo])
}

// Fonte de recurso da dotação. No QDD de Mogi Guaçu é o par fonte/aplicação do
// TCE-SP ("01.1100000"); a correspondência com a fonte STN fica no nome.
model FonteRecurso {
  id          String   @id @default(cuid())
  codigo      String
  nome        String
  exercicioId String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  exercicio Exercicio @relation(fields: [exercicioId], references: [id], onDelete: Cascade)
  dotacoes  Dotacao[]

  @@unique([exercicioId, codigo])
}

// ============================================================================
// INSTRUMENTOS E DOTAÇÕES
// ============================================================================

// PROJETO_LEI é a base das emendas; LEI_APROVADA liga-se ao PL de origem.
model InstrumentoPlanejamento {
  id                  String             @id @default(cuid())
  tipo                TipoInstrumento
  especie             EspecieInstrumento
  numero              String
  ementa              String
  exercicioId         String
  status              StatusInstrumento  @default(EM_ELABORACAO)
  // Link externo (legado). O arquivo da peça enviado pelo sistema fica em arquivoId.
  arquivoUrl          String?
  arquivoId           String?
  // Valor total da despesa impresso na peça: a importação confere contra ele.
  totalImpresso       Decimal?           @db.Decimal(18, 2)
  dataEnvio           DateTime?
  dataAprovacao       DateTime?
  dataVigencia        DateTime?
  instrumentoOrigemId String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  exercicio           Exercicio                 @relation(fields: [exercicioId], references: [id], onDelete: Cascade)
  instrumentoOrigem   InstrumentoPlanejamento?  @relation("InstrumentoOrigem", fields: [instrumentoOrigemId], references: [id])
  arquivo             Arquivo?                  @relation(fields: [arquivoId], references: [id], onDelete: SetNull)
  importacoes         Importacao[]
  prioridades         PrioridadeLdo[]
  derivados           InstrumentoPlanejamento[] @relation("InstrumentoOrigem")
  emendasIncorporadas Emenda[]                  @relation("LeiIncorporacao")
  dotacoes            Dotacao[]

  @@index([exercicioId, especie, status])
}

// Linha do orçamento sobre a qual a emenda incide.
model Dotacao {
  id                    String   @id @default(cuid())
  instrumentoId         String
  exercicioId           String
  // Como a dotação é citada: o número da ação e, quando a ação se repete, o
  // elemento e a ficha ("2048.43").
  codigo                String
  ficha                 String?
  orgaoId               String
  unidadeOrcamentariaId String
  funcaoId              String
  subfuncaoId           String
  programaId            String
  acaoId                String
  naturezaDespesaId     String
  fonteRecursoId        String
  // Valor autorizado na lei. A execução não está disponível: nada aqui é saldo.
  valorAutorizado       Decimal  @db.Decimal(18, 2)
  // Página do anexo de onde a linha foi lida (conferência do OCR).
  paginaFonte           Int?
  // Posição da linha no anexo. O motor desempata candidatas por ela.
  ordem                 Int      @default(0)
  // Falso quando a linha deixou de existir na versão vigente da LOA (a recarga
  // nunca apaga: uma emenda antiga pode apontar para cá).
  ativo                 Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  instrumento         InstrumentoPlanejamento @relation(fields: [instrumentoId], references: [id], onDelete: Cascade)
  exercicio           Exercicio               @relation(fields: [exercicioId], references: [id], onDelete: Cascade)
  orgao               Orgao                   @relation(fields: [orgaoId], references: [id])
  unidadeOrcamentaria UnidadeOrcamentaria     @relation(fields: [unidadeOrcamentariaId], references: [id])
  funcao              Funcao                  @relation(fields: [funcaoId], references: [id])
  subfuncao           Subfuncao               @relation(fields: [subfuncaoId], references: [id])
  programa            Programa                @relation(fields: [programaId], references: [id])
  acao                Acao                    @relation(fields: [acaoId], references: [id])
  naturezaDespesa     NaturezaDespesa         @relation(fields: [naturezaDespesaId], references: [id])
  fonteRecurso        FonteRecurso            @relation(fields: [fonteRecursoId], references: [id])

  emendas Emenda[]

  @@unique([instrumentoId, codigo])
  @@index([exercicioId])
  @@index([unidadeOrcamentariaId])
}

// Meta física da ação nas peças de planejamento (PPA e LDO). É referência de
// redação e de unidade para o plano de trabalho, nunca de quantidade: a emenda
// entrega uma fração da meta do programa.
model MetaAcao {
  id                     String   @id @default(cuid())
  exercicioId            String
  unidadeId              String
  programaId             String
  acaoId                 String
  produto                String
  unidadeMedida          String?
  publicoAlvo            String?
  quantidadePpa          Decimal? @db.Decimal(18, 4)
  quantidadeExercicio    Decimal? @db.Decimal(18, 4)
  beneficiariosExercicio Decimal? @db.Decimal(18, 4)
  notaLdo                String?
  paginaFonte            Int?
  createdAt              DateTime @default(now())

  exercicio Exercicio           @relation(fields: [exercicioId], references: [id], onDelete: Cascade)
  unidade   UnidadeOrcamentaria @relation(fields: [unidadeId], references: [id], onDelete: Cascade)
  programa  Programa            @relation(fields: [programaId], references: [id], onDelete: Cascade)
  acao      Acao                @relation(fields: [acaoId], references: [id], onDelete: Cascade)

  @@unique([unidadeId, programaId, acaoId])
  @@index([exercicioId])
}

// ============================================================================
// NORMAS
// ============================================================================

// Base legal consultável (LOM, LOA, LDO, comunicados do TCE).
model DocumentoNormativo {
  id           String    @id @default(cuid())
  tipo         TipoNorma
  titulo       String
  numero       String?
  artigo       String?
  trecho       String?
  url          String?
  // Data do ato, início e fim de vigência (sem fim = em vigor).
  dataAto      DateTime?
  dataVigencia DateTime?
  vigenciaFim  DateTime?
  // Arquivo do ato enviado pelo sistema.
  arquivoId    String?
  ativo        Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  regras   RegraValidacao[]
  arquivo  Arquivo?         @relation(fields: [arquivoId], references: [id], onDelete: SetNull)
  manualDe Municipio[]      @relation("AtoDoManual")

  @@index([tipo, ativo])
}

// ============================================================================
// MOTOR DE CLASSIFICAÇÃO — catálogos do município
// ============================================================================

// Área de aplicação e os órgãos orçamentários que a atendem. É o que permite
// dizer que "ambulância" não cabe numa escola.
model AreaAplicacao {
  id            String   @id @default(cuid())
  nome          String   @unique
  // Códigos dos órgãos da área ("13", "20").
  orgaos        String[]
  // Unidade que responde pela área quando o destino não tem vínculo fixo.
  unidadePadrao String?
  ordem         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  objetos ObjetoBiblioteca[]
}

// Biblioteca de objetos: o vocabulário que o motor reconhece.
model ObjetoBiblioteca {
  id             String         @id @default(cuid())
  rotulo         String
  termos         String[]
  natureza       NaturezaObjeto
  elemento       String
  divisibilidade Divisibilidade
  subfuncao      String?
  // Estrito: o objeto só cabe na sua própria área (ambulância é Saúde).
  estrito        Boolean        @default(false)
  // Palavras que, no nome da ação, provam aderência ao objeto mesmo sem
  // aparecerem no texto da emenda ("saude mental" para material terapêutico).
  pistas         String[]       @default([])
  explicacao     String
  areaId         String?
  ordem          Int            @default(0)
  ativo          Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  area AreaAplicacao? @relation(fields: [areaId], references: [id], onDelete: SetNull)

  @@index([ativo])
}

// ============================================================================
// DESTINOS (beneficiários)
// ============================================================================

// Para onde vai a emenda: órgão ou equipamento público (execução direta) ou
// entidade do terceiro setor (execução indireta). Atravessa exercícios, por
// isso a unidade é guardada pelo código, não por FK.
// Tipo de equipamento público, reconhecido pelo nome do destino (EMEI, CAPS,
// UBS...). Sugere a subfunção quando o objeto não a define e dá ao motor as
// palavras que provam aderência entre o destino e a ação da LOA.
model TipoDestino {
  id        String   @id @default(cuid())
  nome      String   @unique
  // Expressão regular sobre o nome e o nome oficial, sem acentos, minúsculas.
  padrao    String
  pistas    String[] @default([])
  subfuncao String?
  ordem     Int      @default(0)
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Destino {
  id                   String        @id @default(cuid())
  nome                 String
  nomeOficial          String?
  execucao             FormaExecucao
  // Direta: a unidade orçamentária a que o equipamento está vinculado.
  unidadeCodigo        String?
  // Indireta: sugestão da secretaria repassadora (o objeto decide).
  unidadeRepasseCodigo String?
  endereco             String
  cnpj                 String?
  cnes                 String?
  inep                 String?
  populacaoReferencia  Int?
  fontePopulacao       String?
  dataPopulacao        String?
  responsavelNome      String?
  responsavelCargo     String?
  telefone             String?
  email                String?
  // Documento de habilitação pendente (arts. 33-39 da Lei 13.019/2014).
  pendenciaHabilitacao String?
  // Subfunção que o equipamento sugere quando o objeto não a define (EMEI e
  // CEI → 365; EMEF → 361; EMEB, que atende os dois níveis, fica em branco).
  subfuncaoSugerida    String?
  fonteUrl             String?
  origem               OrigemDestino @default(CADASTRO)
  ativo                Boolean       @default(true)
  // Grafias de beneficiários mesclados neste (a busca as encontra).
  apelidos             String[]      @default([])
  // Mesclado em outro: fica inativo e aponta para o que sobrou.
  mescladoEmId         String?
  criadoPorId          String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  criadoPor User?    @relation(fields: [criadoPorId], references: [id], onDelete: SetNull)
  emendas   Emenda[]

  @@unique([execucao, nome])
  @@index([ativo])
}

// ============================================================================
// EMENDAS
// ============================================================================

// Autor (vereador). Pode existir sem usuário: as emendas importadas têm autor
// real que ainda não acessa o sistema.
model Autor {
  id           String   @id @default(cuid())
  nome         String
  partido      String?
  cargo        String   @default("Vereador")
  usuarioId    String?  @unique
  // Conta de demonstração: real dentro do sistema, fora do portal público e
  // dos relatórios oficiais. Só as emendas dela podem ser apagadas em lote.
  demonstracao Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  usuario           User?             @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  emendas           Emenda[]
  emendasImportadas EmendaImportada[]

  @@unique([nome])
}

// Numeração das emendas por exercício. O número é atribuído na submissão, em
// transação, a partir daqui — nunca por contagem.
model ContadorEmenda {
  id          String @id @default(cuid())
  exercicioId String @unique
  ultimo      Int    @default(0)

  exercicio Exercicio @relation(fields: [exercicioId], references: [id], onDelete: Cascade)
}

model Emenda {
  id          String       @id @default(cuid())
  exercicioId String
  autorId     String
  status      StatusEmenda @default(RASCUNHO)
  // Atribuído na submissão.
  numero      Int?
  // Controle de concorrência: cada gravação incrementa.
  revisao     Int          @default(1)

  // --- etapa 1: descrever ----------------------------------------------------
  execucao        FormaExecucao @default(DIRETA)
  destinoId       String?
  objeto          String        @default("")
  quantidade      String?
  // Valor da emenda informado no passo 1 (rótulo "Valor da emenda"). Ao
  // gravar, `valor` recebe este número; a planilha o comprova.
  valorPretendido Decimal?      @db.Decimal(18, 2)
  endereco        String        @default("")

  // --- classificação ---------------------------------------------------------
  situacao       SituacaoClassificacao?
  dotacaoId      String?
  escolhaDotacao EscolhaDotacao?
  // Fotografia do resultado do motor (objeto reconhecido, natureza, motivo):
  // é o que explica, depois, por que a dotação é esta.
  classificacao  Json?
  parcela        ParcelaCota?
  modelo         ModeloPlanoTrabalho?

  // --- etapa 2: plano de trabalho -------------------------------------------
  agenteExecutor    String               @default("")
  justificativa     String               @default("")
  metaFinalistica   String               @default("")
  etapas            String               @default("")
  etapasEditadas    Boolean              @default(false)
  // Respostas do quadro de viabilidade ("II-0": "Sim").
  quadroViabilidade Json                 @default("{}")
  instrumento       InstrumentoParceria?
  instrumentoOutro  String               @default("")
  elementoOsc       String?
  evento            EventoComprovacao?
  metodoMeta        String?
  metaSugerida      Decimal?             @db.Decimal(18, 4)
  // Soma da memória de cálculo — o valor definitivo.
  valor             Decimal              @default(0) @db.Decimal(18, 2)

  // Incorporada ao texto da lei aprovada (distinto de acatada pela Comissão).
  incorporadaEm    DateTime?
  incorporadaPorId String?
  incorporadaLeiId String?

  // --- etapa 3 ---------------------------------------------------------------
  declaracaoVinculo Boolean   @default(false)
  // O autor declara que pesquisou e informou os preços (responsabilidade dele).
  declaracaoPrecos  Boolean   @default(false)
  // Dotação informada à mão pelo vereador (pedido do Dr. Emerson): os campos
  // digitados, se foi achada na LOA, e quem informou e quando. Achada, a
  // dotacaoId aponta para ela; fora da LOA, vale a declaração abaixo.
  dotacaoInformada  Json?
  // "A classificação foi informada por mim e é de minha responsabilidade."
  declaracaoDotacao Boolean   @default(false)
  submetidaEm       DateTime?

  // --- tramitação (Comissão) -------------------------------------------------
  parecerTramitacao String?
  tramitadaEm       DateTime?
  tramitadaPorId    String?
  // --- diligência da Comissão ---------------------------------------------
  // O que a Comissão pediu para sanear, até quando, e quando o autor reenviou.
  diligenciaMotivo  String?
  diligenciaAte     DateTime?
  diligenciaEm      DateTime?
  reenviadaEm       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  exercicio      Exercicio                @relation(fields: [exercicioId], references: [id], onDelete: Cascade)
  autor          Autor                    @relation(fields: [autorId], references: [id])
  tramitadaPor   User?                    @relation("EmendaTramitada", fields: [tramitadaPorId], references: [id], onDelete: SetNull)
  incorporadaPor User?                    @relation("EmendaIncorporada", fields: [incorporadaPorId], references: [id], onDelete: SetNull)
  incorporadaLei InstrumentoPlanejamento? @relation("LeiIncorporacao", fields: [incorporadaLeiId], references: [id], onDelete: SetNull)
  destino        Destino?                 @relation(fields: [destinoId], references: [id], onDelete: SetNull)
  dotacao        Dotacao?                 @relation(fields: [dotacaoId], references: [id], onDelete: SetNull)
  metas          MetaEmenda[]
  referencias    ReferenciaPreco[]
  itens          ItemEmenda[]
  parcelas       ParcelaDesembolso[]
  validacoes     ValidacaoEmenda[]
  pareceres      ParecerViabilidade[]
  andamentos     AndamentoExecucao[]
  convites       ConviteEntidade[]
  historico      HistoricoEmenda[]

  @@unique([exercicioId, numero])
  @@index([exercicioId, status])
  @@index([autorId])
  @@index([dotacaoId])
  @@index([destinoId])
}

// Meta física: quem será atendido e quanto será entregue.
model MetaEmenda {
  id            String  @id @default(cuid())
  emendaId      String
  ordem         Int
  beneficiarios String
  unidade       String
  quantidade    Decimal @db.Decimal(18, 4)

  emenda Emenda @relation(fields: [emendaId], references: [id], onDelete: Cascade)

  @@index([emendaId])
}

// Referência de preço registrada na emenda. Cada linha da memória de cálculo
// aponta para uma; é este cadastro que vira o quadro de origem dos preços.
model ReferenciaPreco {
  id            String                @id @default(cuid())
  emendaId      String
  // "R1", "R2"… — o rótulo que aparece na memória de cálculo.
  codigo        String
  tipo          TipoReferenciaPreco
  // Campos próprios do tipo (número da ata, composição SINAPI, CNPJ…).
  campos        Json                  @default("{}")
  emissor       String
  data          DateTime?
  // Período como a fonte informa, quando não há data exata.
  dataTexto     String?
  unidade       String
  valor         Decimal               @db.Decimal(18, 2)
  objeto        String
  porte         String?
  link          String?
  observacao    String?
  procedencia   ProcedenciaReferencia @default(INFORMADA)
  aprovadoPor   String?
  aprovadoEm    DateTime?
  origemExterna String?
  consultadoEm  DateTime?
  // Fonte oficial de onde o autor tirou o preço (nula em "outra fonte").
  fonteId       String?

  emenda Emenda             @relation(fields: [emendaId], references: [id], onDelete: Cascade)
  fonte  FontePrecoOficial? @relation(fields: [fonteId], references: [id], onDelete: SetNull)
  itens  ItemEmenda[]

  @@unique([emendaId, codigo])
}

// Fonte oficial de preço que o sistema indica ao autor da emenda, com o link
// para pesquisar. O sistema não busca nem sugere preço: aponta onde buscar.
model FontePrecoOficial {
  id             String              @id @default(cuid())
  nome           String              @unique
  url            String
  // Como pesquisar, em uma ou duas frases.
  orientacao     String
  // Para que despesas serve: modelos de plano (CUSTEIO, OBRAS, EQUIPAMENTOS,
  // TERCEIRO_SETOR) e SAUDE. Vazio = serve para tudo.
  aplicaA        String[]            @default([])
  // Como a referência tirada desta fonte é classificada.
  tipo           TipoReferenciaPreco
  // Fonte recomendada: aparece primeiro, em destaque (banco de preços i10).
  destaque       Boolean             @default(false)
  // Tabela que exige assinatura paga (CPOS/CDHU): o autor é avisado.
  assinaturaPaga Boolean             @default(false)
  ordem          Int                 @default(0)
  ativo          Boolean             @default(true)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  referencias ReferenciaPreco[]

  @@index([ativo, ordem])
}

// Link para a entidade beneficiária preencher o plano de trabalho sem cadastro.
// De uso único: morre no envio. Só o resumo SHA-256 do código é guardado.
model ConviteEntidade {
  id               String    @id @default(cuid())
  emendaId         String
  codigoHash       String    @unique
  expiraEm         DateTime
  criadoPorId      String?
  criadoEm         DateTime  @default(now())
  revogadoEm       DateTime?
  revogadoPorId    String?
  // Envio da entidade.
  usadoEm          DateTime?
  responsavelNome  String?
  responsavelCargo String?
  enviadoDeIp      String?
  // O plano como a entidade enviou. O gabinete aplica (ou não) ao rascunho.
  conteudo         Json?
  aplicadoEm       DateTime?
  aplicadoPorId    String?

  emenda Emenda @relation(fields: [emendaId], references: [id], onDelete: Cascade)

  @@index([emendaId])
}

// Linha da memória de cálculo. O total é derivado (quantidade × unitário).
model ItemEmenda {
  id            String  @id @default(cuid())
  emendaId      String
  ordem         Int
  descricao     String
  // Unidade de medida da quantidade ("kit", "caixa", "peça"). Comparada com a
  // unidade da referência de preço apontada.
  unidade       String?
  quantidade    Decimal @db.Decimal(18, 4)
  valorUnitario Decimal @db.Decimal(18, 2)
  referenciaId  String?

  emenda     Emenda           @relation(fields: [emendaId], references: [id], onDelete: Cascade)
  referencia ReferenciaPreco? @relation(fields: [referenciaId], references: [id], onDelete: SetNull)

  @@index([emendaId])
}

// Parcela do cronograma de desembolso previsto. As datas são da execução.
model ParcelaDesembolso {
  id       String  @id @default(cuid())
  emendaId String
  ordem    Int
  valor    Decimal @db.Decimal(18, 2)

  emenda Emenda @relation(fields: [emendaId], references: [id], onDelete: Cascade)

  @@index([emendaId])
}

// Resultado da validação no momento da submissão (o que o autor viu).
model ValidacaoEmenda {
  id           String           @id @default(cuid())
  emendaId     String
  bloqueios    Int
  alertas      Int
  // As conferências do motor RIEP (complementares às treze).
  itens        Json
  // As treze, na ordem: [{ codigo, numero, titulo, estado, razao, fundamento, modo }].
  verificacoes Json             @default("[]")
  valida       Boolean          @default(false)
  momento      MomentoValidacao @default(VALIDACAO)
  revisao      Int?
  usuarioId    String?
  executadaEm  DateTime         @default(now())

  emenda Emenda @relation(fields: [emendaId], references: [id], onDelete: Cascade)

  @@index([emendaId])
}

// Emendas apresentadas fora do sistema (ex.: as 351 emendas ao PL da LOA 2026,
// lidas por OCR). Contam para a cota do autor. Sem área identificada, dividem-se
// entre saúde e demais pela meação legal.
model EmendaImportada {
  id              String       @id @default(cuid())
  exercicioId     String
  autorId         String
  numero          Int
  descricao       String
  valor           Decimal      @db.Decimal(18, 2)
  parcela         ParcelaCota?
  saudeHeuristica Boolean      @default(false)
  observacao      String?
  fonte           String?
  createdAt       DateTime     @default(now())

  exercicio Exercicio @relation(fields: [exercicioId], references: [id], onDelete: Cascade)
  autor     Autor     @relation(fields: [autorId], references: [id], onDelete: Cascade)

  @@unique([exercicioId, numero])
  @@index([autorId])
}

// ============================================================================
// PARTICIPAÇÃO DO EXECUTIVO
// ============================================================================

// Parecer de viabilidade técnica. Informativo: não altera a emenda nem trava a
// tramitação. Vale o mais recente.
model ParecerViabilidade {
  id            String               @id @default(cuid())
  emendaId      String
  resultado     ResultadoViabilidade
  justificativa String
  usuarioId     String?
  criadoEm      DateTime             @default(now())

  emenda  Emenda @relation(fields: [emendaId], references: [id], onDelete: Cascade)
  usuario User?  @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([emendaId, criadoEm])
}

// Andamento da execução orçamentária, lançado pelo Executivo.
model AndamentoExecucao {
  id              String        @id @default(cuid())
  emendaId        String
  etapa           EtapaExecucao
  data            DateTime
  valor           Decimal       @db.Decimal(18, 2)
  numeroDocumento String?
  observacao      String?
  usuarioId       String?
  criadoEm        DateTime      @default(now())

  emenda  Emenda @relation(fields: [emendaId], references: [id], onDelete: Cascade)
  usuario User?  @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([emendaId])
}

// ============================================================================
// ACESSO E AUDITORIA
// ============================================================================

// Perfil de acesso: um Poder de atuação combinado com permissões atômicas.
// `poder` nulo = transversal. `adminGeral` passa por tudo.
model PerfilAcesso {
  id        String  @id @default(cuid())
  nome      String  @unique
  descricao String?
  poder     Poder?

  apresentarEmendas        Boolean @default(false)
  gerirTodasEmendas        Boolean @default(false)
  tramitarEmendas          Boolean @default(false)
  gerirPlanejamento        Boolean @default(false)
  gerirExercicios          Boolean @default(false)
  administrarConfiguracoes Boolean @default(false)
  analisarViabilidade      Boolean @default(false)
  registrarExecucao        Boolean @default(false)
  // Lê tudo (emendas, tramitação, planejamento, execução, conformidade,
  // auditoria) sem escrever nada.
  consultarTudo            Boolean @default(false)

  perfilDoSistema Boolean @default(false)
  adminGeral      Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usuarios User[]
}

model User {
  id             String    @id @default(cuid())
  name           String?
  email          String?   @unique
  emailVerified  DateTime?
  image          String?
  passwordHash   String?
  perfilId       String?
  // Desativado não entra; o histórico e a autoria continuam.
  ativo          Boolean   @default(true)
  // Conta criada pelo administrador (ou pelo comando do sistema vazio): no
  // primeiro login, troca a senha temporária e confere nome e e-mail.
  primeiroAcesso Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  perfil              PerfilAcesso?        @relation(fields: [perfilId], references: [id], onDelete: SetNull)
  accounts            Account[]
  sessions            Session[]
  autor               Autor?
  auditLogs           AuditLog[]
  pareceres           ParecerViabilidade[]
  andamentos          AndamentoExecucao[]
  destinos            Destino[]
  emendasTramitadas   Emenda[]             @relation("EmendaTramitada")
  emendasIncorporadas Emenda[]             @relation("EmendaIncorporada")
  historicos          HistoricoEmenda[]
  arquivos            Arquivo[]
  manuaisPublicados   Municipio[]          @relation("ManualPublicado")
  guiasVistos         GuiaVisto[]

  @@index([perfilId])
}

// Guias de ajuda (balões sobre a tela) que cada pessoa já viu. O guia abre
// sozinho na primeira visita da pessoa ao módulo; concluir ou pular grava aqui
// e ele não abre mais — salvo quando o conteúdo muda (a versão do guia sobe) ou
// a pessoa pede "Rever todos os guias" em Minha conta.
model GuiaVisto {
  id          String    @id @default(cuid())
  usuarioId   String
  // Identificador do guia em src/config/guias.ts ("inicio", "config.areas").
  guia        String
  versao      Int
  concluidoEm DateTime?
  puladoEm    DateTime?
  // Marcado por "Pular todos".
  pulouTodos  Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  usuario User @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, guia])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// Trilha de auditoria: toda mutação relevante grava antes/depois.
model AuditLog {
  id          String   @id @default(cuid())
  usuarioId   String?
  entidade    String
  entidadeId  String
  acao        String
  dadosAntes  Json?
  dadosDepois Json?
  criadoEm    DateTime @default(now())

  usuario User? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([usuarioId])
  @@index([entidade, entidadeId])
  @@index([criadoEm])
}

// Cada mudança de situação da emenda, com data, quem e o texto (parecer,
// pedido de ajuste, devolução). É a base dos relatórios por período.
model HistoricoEmenda {
  id        String        @id @default(cuid())
  emendaId  String
  de        StatusEmenda?
  para      StatusEmenda
  texto     String?
  usuarioId String?
  criadoEm  DateTime      @default(now())

  emenda  Emenda @relation(fields: [emendaId], references: [id], onDelete: Cascade)
  usuario User?  @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([emendaId, criadoEm])
  @@index([criadoEm])
}

// Arquivo guardado pelo sistema (Vercel Blob privado em produção; disco em
// ambiente local). O conteúdo nunca passa pelo banco.
model Arquivo {
  id           String     @id @default(cuid())
  nome         String
  tipo         String
  tamanho      Int
  sha256       String
  // Caminho no armazenamento.
  chave        String     @unique
  uso          UsoArquivo
  // Público: baixa sem login (peça orçamentária e norma publicadas).
  publico      Boolean    @default(false)
  enviadoPorId String?
  criadoEm     DateTime   @default(now())

  enviadoPor   User?                     @relation(fields: [enviadoPorId], references: [id], onDelete: SetNull)
  instrumentos InstrumentoPlanejamento[]
  importacoes  Importacao[]
  normas       DocumentoNormativo[]

  @@index([uso])
}

// Tentativas de operações sensíveis (login, link público, importação). O
// limite vale para todas as instâncias do servidor porque fica no banco.
model TentativaAcesso {
  id       String   @id @default(cuid())
  chave    String
  criadoEm DateTime @default(now())

  @@index([chave, criadoEm])
}

// Uso do serviço de IA, para acompanhar custo.
model UsoIA {
  id            String   @id @default(cuid())
  operacao      String
  modelo        String
  // Páginas lidas (importação) ou 1 (redação).
  unidades      Int      @default(1)
  tokensEntrada Int      @default(0)
  tokensSaida   Int      @default(0)
  usuarioId     String?
  criadoEm      DateTime @default(now())

  @@index([criadoEm])
}

// Importação da base em andamento: o arquivo, como ele foi lido, as linhas
// (válidas e recusadas) e a conferência. Nada vai para a base antes da
// confirmação.
model Importacao {
  id            String             @id @default(cuid())
  instrumentoId String
  arquivoId     String
  tipoCarga     TipoCarga
  formato       FormatoImportacao
  situacao      SituacaoImportacao
  // Planilha: cabeçalho lido e coluna de cada campo.
  cabecalho     String[]           @default([])
  mapa          Json?
  // PDF: páginas, lotes, cabeçalho em vigor, totais impressos lidos.
  progresso     Json?
  paginas       Int?
  paginasLidas  Int                @default(0)
  // Faixa de páginas do quadro informada por quem importa (opcional).
  paginaInicial Int?
  paginaFinal   Int?
  totalImpresso Decimal?           @db.Decimal(18, 2)
  totalLido     Decimal?           @db.Decimal(18, 2)
  erro          String?
  resumo        Json?
  criadoPorId   String?
  criadoEm      DateTime           @default(now())
  atualizadoEm  DateTime           @updatedAt
  gravadaEm     DateTime?
  gravadaPorId  String?

  instrumento InstrumentoPlanejamento @relation(fields: [instrumentoId], references: [id], onDelete: Cascade)
  arquivo     Arquivo                 @relation(fields: [arquivoId], references: [id])
  linhas      LinhaImportada[]

  @@index([instrumentoId, criadoEm])
}

// Uma linha lida: os campos como vieram (corrigíveis na tela), os motivos de
// recusa e os avisos de conferência.
model LinhaImportada {
  id             String    @id @default(cuid())
  importacaoId   String
  // Linha da planilha, ou a ordem da leitura no PDF.
  numero         Int
  pagina         Int?
  campos         Json
  motivos        String[]  @default([])
  avisos         String[]  @default([])
  corrigidaPorId String?
  corrigidaEm    DateTime?
  // Incluída à mão na conferência (linha que a leitura não pegou).
  incluida       Boolean   @default(false)

  importacao Importacao @relation(fields: [importacaoId], references: [id], onDelete: Cascade)

  @@index([importacaoId, numero])
}

// Prioridade e meta do Anexo de Metas e Prioridades da LDO, por programa (e
// ação). A verificação de aderência à LDO confere a emenda contra elas.
model PrioridadeLdo {
  id            String   @id @default(cuid())
  exercicioId   String
  instrumentoId String?
  programaId    String
  acaoId        String?
  descricao     String
  meta          Decimal? @db.Decimal(18, 4)
  unidadeMedida String?
  createdAt     DateTime @default(now())

  exercicio   Exercicio                @relation(fields: [exercicioId], references: [id], onDelete: Cascade)
  instrumento InstrumentoPlanejamento? @relation(fields: [instrumentoId], references: [id], onDelete: SetNull)
  programa    Programa                 @relation(fields: [programaId], references: [id], onDelete: Cascade)
  acao        Acao?                    @relation(fields: [acaoId], references: [id], onDelete: SetNull)

  @@index([exercicioId, programaId])
}

// Regra de validação: modo (bloqueante ou alerta), se está ligada, o
// fundamento por extenso e a norma citada. Sem exercício, vale para todos;
// com exercício, prevalece sobre a geral. O motor lê daqui: mudar a regra não
// exige publicar o sistema.
model RegraValidacao {
  id          String        @id @default(cuid())
  codigo      String
  exercicioId String?
  modo        ModoValidacao
  ativa       Boolean       @default(true)
  fundamento  String?
  normaId     String?
  // Parâmetro da regra, quando houver.
  parametros  Json?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  exercicio Exercicio?          @relation(fields: [exercicioId], references: [id], onDelete: Cascade)
  norma     DocumentoNormativo? @relation(fields: [normaId], references: [id], onDelete: SetNull)

  @@unique([codigo, exercicioId])
  @@index([codigo])
}
