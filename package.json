{
  "name": "emendas-parlamentares",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "tsx prisma/seed.ts",
    "postinstall": "prisma generate",
    "db:up": "docker compose up -d",
    "db:migrate": "prisma migrate dev",
    "db:senha": "tsx prisma/redefinir-senha.ts",
    "db:extrair-qdd": "tsx prisma/extrair-qdd.ts",
    "db:carregar-exercicio": "tsx prisma/carregar-exercicio.ts",
    "db:recarregar-loa": "tsx prisma/recarregar-loa.ts",
    "db:recarregar-catalogos": "tsx prisma/recarregar-catalogos.ts",
    "db:apagar-emendas": "tsx prisma/apagar-emendas-lote.ts",
    "db:marcar-demonstracao": "tsx prisma/marcar-demonstracao.ts",
    "db:iniciar-vazio": "tsx prisma/iniciar-vazio.ts",
    "test:e2e": "tsx e2e/preparar.ts && playwright test",
    "test:e2e:vazio": "tsx e2e/vazio/preparar.ts && playwright test -c playwright.vazio.config.ts",
    "prova": "tsx e2e/preparar.ts && playwright test e2e/prova && playwright test e2e/prova"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.2",
    "@hookform/resolvers": "^5.4.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@vercel/blob": "^2.8.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "driver.js": "1.8.0",
    "lucide-react": "^1.23.0",
    "next": "16.2.10",
    "next-auth": "^5.0.0-beta.31",
    "next-themes": "^0.4.6",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "pg": "^8.22.0",
    "prisma": "^7.8.0",
    "radix-ui": "^1.6.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.80.0",
    "shadcn": "^4.12.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5",
    "vitest": "^4.1.9"
  }
}
