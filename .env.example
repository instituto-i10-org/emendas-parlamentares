# Copie para .env e preencha com valores reais. NÃO versione o .env.

# PostgreSQL — pooled, usado em runtime pela aplicação (driver adapter).
# Banco local (npm run db:up): postgresql://emendas:emendas@localhost:5440/emendas
DATABASE_URL=""

# PostgreSQL — conexão direta (não-pooled), usada nas migrations (Prisma CLI).
# No banco local, igual à DATABASE_URL.
DIRECT_URL=""

# Auth.js — gere com: npx auth secret
AUTH_SECRET=""

# AUTH_URL não é necessário — authConfig usa trustHost e o Auth.js deriva a
# URL do host da requisição. Só defina se for servir atrás de um proxy que
# reescreva o host. NUNCA aponte para localhost em produção.

# "Melhorar texto" na criação da emenda — OpenAI. Sem a chave o botão avisa
# que o recurso aguarda configuração; o resto do sistema funciona.
OPENAI_API_KEY=""
# Modelo usado na revisão de texto (padrão: gpt-4.1-mini)
OPENAI_MODEL=""

# Senha das contas criadas pelo seed (*@emendas360.local). Vazio: o seed gera
# uma senha aleatória e a mostra uma única vez.
SEED_SENHA=""

# Acesso rápido de demonstração na tela de login. Só aparece com DEMO_SENHA
# definida (a mesma senha das contas do seed). DEMO_LOGIN="false" esconde.
DEMO_LOGIN=""
DEMO_SENHA=""
