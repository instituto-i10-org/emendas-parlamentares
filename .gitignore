# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
Thumbs.db

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — NUNCA versionar segredos; o .env.example (sem valores) é permitido
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma — client gerado (recriado por `prisma generate`)
/src/generated

# uploads locais (LOM, RI, instrumentos de planejamento)
/uploads

.vercel

# playwright (testes end-to-end)
/test-results
/playwright-report
/blob-report
/playwright/.cache

# Arquivos enviados no ambiente local (sem Blob)
/.armazenamento/
